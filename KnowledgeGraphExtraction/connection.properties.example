# Connection settings for graphrag_showcase.py and the benchmark scripts.
# Copy this file to connection.properties (git-ignored) and keep only the values you change; keys left out use the
# defaults shown here. The app never reads this .example file. Lines are KEY=VALUE with the same names as the
# environment variables; an exported environment variable wins over connection.properties.
# Lines starting with # or ! are comments.

# Where you cloned hugegraph-ai (README step 1); read by `pip install -r requirements.txt` (README step 3), not by the app.
# Use an absolute path: $HOME and ~ are not expanded here.
#HUGEGRAPH_AI_HOME=/path/to/hugegraph-ai

# HugeGraph server
HUGEGRAPH_URL=127.0.0.1:8080
HUGEGRAPH_GRAPH=hugegraph
# Blank means the server's default graph space (DEFAULT on HugeGraph 1.7 and later).
HUGEGRAPH_GRAPHSPACE=
HUGEGRAPH_USER=admin
HUGEGRAPH_PASSWORD=admin
# Backend for a new graph in an empty graph space: rocksdb (standalone) or hstore (cluster with PD).
# When left out and the graph space has other graphs, a new graph copies the configuration of one of them.
#HUGEGRAPH_BACKEND=hstore

# LLM provider: ollama, claude or openai. Model and key settings use the names listed in README.md.
#LLM_PROVIDER=claude
#ANTHROPIC_BASE_URL=https://ai-gateway.example.com
# Must be a model your key may use: a gateway answers 403 "key_model_access_denied ... can only access models=[...]"
# otherwise. Used as anthropic/<value>; CLAUDE_MODEL=anthropic/<model> sets the full name instead.
#ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6

# Ollama (local models and, with Claude, embeddings)
#OLLAMA_HOST_IP=127.0.0.1
#OLLAMA_PORT=11434
